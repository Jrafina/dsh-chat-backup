{
  "name": "@local/dsh-chat-backup",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "One-click conversation backup: transcript + latest deliverables, packed and uploaded to Cloudflare R2",
  "keywords": ["dsh", "dsh-bundle", "backup", "cloudflare-r2"],
  "license": "UNLICENSED",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
